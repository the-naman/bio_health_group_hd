{
  "datasets": [
    {
      "name": "kpi",
      "displayName": "Group KPIs",
      "queryLines": [
        "SELECT max(CASE WHEN kpi = 'people' THEN value END) AS people,\n",
        "       max(CASE WHEN kpi = 'people_shared' THEN value END) AS people_shared,\n",
        "       max(CASE WHEN kpi = 'group_exposure' THEN value END) AS group_exposure,\n",
        "       max(CASE WHEN kpi = 'people_over_limit' THEN value END) AS people_over_limit,\n",
        "       max(CASE WHEN kpi = 'intercompany_breaks' THEN value END) AS intercompany_breaks,\n",
        "       max(CASE WHEN kpi = 'reviews_open' THEN value END) AS reviews_open,\n",
        "       max(as_of_date) AS as_of_date\n",
        "FROM bhg_dev.gold.v_group_kpi\n"
      ]
    },
    {
      "name": "bhg_month",
      "displayName": "BHG by month",
      "queryLines": [
        "SELECT year_month, measure, sum(group_amount) AS group_amount\n",
        "FROM bhg_dev.gold.v_group_daily WHERE company_code = 'bhg' AND measure IN ('billed', 'collected')\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "fqf_month",
      "displayName": "FQF by month",
      "queryLines": [
        "SELECT year_month, measure, sum(group_amount) AS group_amount\n",
        "FROM bhg_dev.gold.v_group_daily WHERE company_code = 'fqf' AND measure IN ('disbursed', 'collected')\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "intercompany",
      "displayName": "Intercompany by month",
      "queryLines": [
        "SELECT year_month, company_name, sum(intercompany) AS intercompany\n",
        "FROM bhg_dev.gold.v_group_daily WHERE intercompany <> 0\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "exposure",
      "displayName": "Exposure by city",
      "queryLines": [
        "SELECT city, CASE WHEN over_limit THEN 'over limit' ELSE 'within limit' END AS limit_status,\n",
        "       sum(people) AS people, sum(total_exposure) AS total_exposure\n",
        "FROM bhg_dev.gold.v_group_exposure\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "customers",
      "displayName": "People by city",
      "queryLines": [
        "SELECT city, CASE WHEN is_shared THEN 'both companies'\n",
        "                  WHEN is_bhg_patient THEN 'BHG only' ELSE 'FQF only' END AS relationship,\n",
        "       sum(people) AS people\n",
        "FROM bhg_dev.gold.v_group_customers\n",
        "GROUP BY ALL\n"
      ]
    }
  ],
