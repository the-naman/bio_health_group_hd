{
  "datasets": [
    {
      "name": "kpi",
      "displayName": "Headline numbers",
      "queryLines": [
        "SELECT hospital,\n",
        "       sum(CASE WHEN event_group IN ('charge', 'adjustment') THEN amount ELSE 0 END) AS billed,\n",
        "       sum(CASE WHEN event_group = 'collection' THEN amount ELSE 0 END) AS collected,\n",
        "       sum(CASE WHEN event_group IN ('charge', 'adjustment') THEN amount ELSE 0 END)\n",
        "         - sum(CASE WHEN event_group = 'collection' THEN amount ELSE 0 END) AS unpaid,\n",
        "       sum(CASE WHEN event_type = 'consult' THEN events ELSE 0 END) AS consults,\n",
        "       sum(CASE WHEN event_type = 'room' THEN events ELSE 0 END) AS admissions,\n",
        "       sum(CASE WHEN event_type = 'pharmacy' THEN events ELSE 0 END) AS pharmacy_sales\n",
        "FROM bhg_dev.gold.v_bhg_revenue_daily\n",
        "GROUP BY hospital\n"
      ]
    },
    {
      "name": "month",
      "displayName": "Billed vs collected by month",
      "queryLines": [
        "SELECT year_month, hospital,\n",
        "       CASE WHEN event_group = 'collection' THEN 'collected' ELSE 'billed' END AS measure,\n",
        "       sum(amount) AS amount\n",
        "FROM bhg_dev.gold.v_bhg_revenue_daily\n",
        "WHERE date <= (SELECT CASE WHEN max(date) = last_day(max(date)) THEN max(date)\n",
        "                           ELSE last_day(add_months(max(date), -1)) END FROM bhg_dev.gold.v_bhg_revenue_daily)   -- complete months only\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "hosp",
      "displayName": "By hospital",
      "queryLines": [
        "SELECT hospital,\n",
        "       sum(CASE WHEN event_group IN ('charge', 'adjustment') THEN amount ELSE 0 END) AS billed,\n",
        "       sum(CASE WHEN event_group = 'collection' THEN amount ELSE 0 END) AS collected,\n",
        "       round(100 * try_divide(sum(CASE WHEN event_group = 'collection' THEN amount ELSE 0 END),\n",
        "                              sum(CASE WHEN event_group IN ('charge', 'adjustment') THEN amount ELSE 0 END)), 1) AS collection_pct\n",
        "FROM bhg_dev.gold.v_bhg_revenue_daily\n",
        "GROUP BY hospital\n"
      ]
    },
    {
      "name": "mix",
      "displayName": "Charges by type",
      "queryLines": [
        "SELECT hospital, event_type, sum(amount) AS amount\n",
        "FROM bhg_dev.gold.v_bhg_revenue_daily WHERE event_group = 'charge'\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "payer",
      "displayName": "Billed by payer type",
      "queryLines": [
        "SELECT hospital, payer_type, sum(amount) AS amount\n",
        "FROM bhg_dev.gold.v_bhg_revenue_daily WHERE event_group IN ('charge', 'adjustment')\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "age",
      "displayName": "Billed by age band",
      "queryLines": [
        "SELECT hospital, age_band, sum(amount) AS amount\n",
        "FROM bhg_dev.gold.v_bhg_revenue_daily WHERE event_group IN ('charge', 'adjustment')\n",
        "GROUP BY ALL\n"
      ]
    }
  ],
