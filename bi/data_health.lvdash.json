{
  "datasets": [
    {
      "name": "runs",
      "displayName": "Job runs",
      "queryLines": [
        "SELECT company, job, split(job, '[.]')[0] AS stage, lower(last_status) AS last_status, 1 AS jobs, last_run, runs_7d, failures_7d,\n",
        "       CASE WHEN lower(last_status) IN ('success', 'rejected') THEN 0 ELSE 1 END AS failing_now   -- rejected = bad file set aside, not a crash\n",
        "FROM (SELECT 'BHG' AS company, * FROM bhg_dev.gold.v_health_runs\n",
        "UNION ALL SELECT 'FQF' AS company, * FROM fqf_dev.gold.v_health_runs)\n"
      ]
    },
    {
      "name": "runs_7d",
      "displayName": "Runs in the last 7 days",
      "queryLines": [
        "SELECT company, split(job, '[.]')[0] AS stage, 'succeeded' AS outcome, runs_7d - failures_7d AS runs FROM (SELECT 'BHG' AS company, * FROM bhg_dev.gold.v_health_runs\n",
        "UNION ALL SELECT 'FQF' AS company, * FROM fqf_dev.gold.v_health_runs)\n",
        "UNION ALL\n",
        "SELECT company, split(job, '[.]')[0], 'not succeeded', failures_7d FROM (SELECT 'BHG' AS company, * FROM bhg_dev.gold.v_health_runs\n",
        "UNION ALL SELECT 'FQF' AS company, * FROM fqf_dev.gold.v_health_runs)\n"
      ]
    },
    {
      "name": "fresh",
      "displayName": "Freshness",
      "queryLines": [
        "SELECT company, fact, data_to, days_behind, built_at\n",
        "FROM (SELECT 'BHG' AS company, * FROM bhg_dev.gold.v_health_freshness\n",
        "UNION ALL SELECT 'FQF' AS company, * FROM fqf_dev.gold.v_health_freshness)\n"
      ]
    },
    {
      "name": "dq",
      "displayName": "Data quality (latest check)",
      "queryLines": [
        "SELECT company, table_name, rule, concat(table_name, ' · ', rule) AS check_name, status, checked, failed,\n",
        "       CASE WHEN lower(status) = 'pass' THEN 0 ELSE 1 END AS not_passing\n",
        "FROM (SELECT 'BHG' AS company, * FROM bhg_dev.gold.v_health_dq\n",
        "UNION ALL SELECT 'FQF' AS company, * FROM fqf_dev.gold.v_health_dq)\n"
      ]
    },
    {
      "name": "dq_fail",
      "displayName": "Data quality failures",
      "queryLines": [
        "SELECT company, concat(table_name, ' · ', rule) AS check_name, status, failed\n",
        "FROM (SELECT 'BHG' AS company, * FROM bhg_dev.gold.v_health_dq\n",
        "UNION ALL SELECT 'FQF' AS company, * FROM fqf_dev.gold.v_health_dq)\n",
        "WHERE failed > 0\n"
      ]
    },
    {
      "name": "quarantine",
      "displayName": "Quarantine",
      "queryLines": [
        "SELECT company, table_name, rule, status, rows,\n",
        "       CASE WHEN status = 'open' THEN rows ELSE 0 END AS open_rows\n",
        "FROM (SELECT 'BHG' AS company, * FROM bhg_dev.gold.v_health_quarantine\n",
        "UNION ALL SELECT 'FQF' AS company, * FROM fqf_dev.gold.v_health_quarantine)\n"
      ]
    },
    {
      "name": "merge",
      "displayName": "Group merge runs",
      "queryLines": [
        "SELECT date_format(run_ts, 'yyyy-MM-dd HH:mm') AS run_time, 'backlog days' AS measure, backlog_days AS days\n",
        "FROM bhg_dev.gold.v_health_merge\n",
        "UNION ALL\n",
        "SELECT date_format(run_ts, 'yyyy-MM-dd HH:mm'), 'new FQF days', new_fqf_days\n",
        "FROM bhg_dev.gold.v_health_merge\n"
      ]
    },
    {
      "name": "merge_now",
      "displayName": "Latest merge",
      "queryLines": [
        "SELECT backlog_days, status\n",
        "FROM bhg_dev.gold.v_health_merge\n",
        "ORDER BY run_ts DESC LIMIT 1\n"
      ]
    }
  ],
